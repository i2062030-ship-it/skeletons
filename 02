<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Premium Video Editing</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

<header class="navbar">
  <div class="logo">MAXENCORE</div>
  <nav>
    <a href="#">Обо мне</a>
